<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.myuuiii</groupId>
    <artifactId>EmpireWandPlus</artifactId>
    <version>2.3.1-beta</version>
    <packaging>jar</packaging>

    <name>EmpireWandPlus</name>

    <properties>
        <java.version>1.21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <profile>
            <id>mc1.21.5</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <minecraft.version>1.21.5-R0.1-SNAPSHOT</minecraft.version>
                <minecraft.short.version>1.21.5</minecraft.short.version>
            </properties>
        </profile>
        <profile>
            <id>mc1.21.4</id>
            <properties>
                <minecraft.version>1.21.4-R0.1-SNAPSHOT</minecraft.version>
                <minecraft.short.version>1.21.4</minecraft.short.version>
            </properties>
        </profile>
        <profile>
            <id>mc1.21.3</id>
            <properties>
                <minecraft.version>1.21.3-R0.1-SNAPSHOT</minecraft.version>
                <minecraft.short.version>1.21.3</minecraft.short.version>
            </properties>
        </profile>
        <profile>
            <id>mc1.21.2</id>
            <properties>
                <minecraft.version>1.21.2-R0.1-SNAPSHOT</minecraft.version>
                <minecraft.short.version>1.21.2</minecraft.short.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <directory>target/minecraft-${minecraft.short.version}</directory>
        <finalName>${artifactId}-${version}-mc${minecraft.short.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>16</source>
                    <target>16</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>${project.build.finalName}-shaded</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${minecraft.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>